# Resend (https://resend.com) API key used to send expense-report emails.
# Create one at https://resend.com/api-keys. Required for the "Send via Email"
# feature - without it, the /api/send-expense-email route returns a clear error.
RESEND_API_KEY=re_your_resend_api_key_here

# The "from" address used when sending expense report emails via Resend.
# This MUST be an address on a domain you have verified in the Resend
# dashboard (Domains -> Add Domain -> add the DNS records Resend gives you).
# Until a domain is verified, Resend only lets you send from
# "onboarding@resend.dev" (fine for local testing, not for production).
RESEND_FROM_EMAIL="The V7 Ninja Expense Tracker <expenses@yourdomain.com>"

# Optional: override the canonical site URL used in metadata/sitemap/JSON-LD.
# Defaults to https://expenses.thev7ninja.in when unset.
NEXT_PUBLIC_APP_URL=https://expenses.thev7ninja.in

